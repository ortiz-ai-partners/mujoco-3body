# local environments and caches
.venv/
__pycache__/
MUJOCO_LOG.TXT

# render intermediates (the muxed mp4 with audio is kept; silent track and wav are rebuilt by v7_full.py)
out/*_silent.mp4
out/*_chirps.wav

# early takes kept locally only (v1 is 15 MB of z-fighting; 3body_arena.mp4 duplicates v3)
out/3body_arena_v1.mp4
out/3body_arena.mp4

# render variants kept locally only (failed or superseded renders) and stray error logs
out/*.err
out/*_cutbug*
out/*_longnotice*
out/*_widebox*
out/*.notion.mp4
# the course opening / end cards (the course's material, kept locally only)
out/oped/
out/submission*.mp4
out/intro_draft*
out/bgm_audition/
out/music/
